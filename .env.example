# ==============================================================================
# Battery Cell Imbalance Detection Using IoT Analytics - Configuration Template
# Copy this file to .env and configure as needed.
# DO NOT commit your actual .env file with secrets into version control.
# ==============================================================================

# Operating Mode: 'simulation' (local synthetic data) or 'hardware' (ESP32/Live MQTT)
APP_MODE=simulation

# MQTT Broker Configuration (Local Broker or HiveMQ Cloud)
# For local Mosquitto: host=localhost, port=1883, use_tls=false
# For HiveMQ Cloud: host=xxxx.s1.eu.hivemq.cloud, port=8883, use_tls=true
MQTT_BROKER_HOST=
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=battery/cells/data
MQTT_CLIENT_ID=battery_monitor_dashboard

# Database Configuration (Relative to project root or absolute path)
DATABASE_PATH=data/battery.db

# Sampling and Pipeline Settings
DATA_INTERVAL_SECONDS=2
ALERT_COOLDOWN_SECONDS=60

# Battery Thresholds (Default demonstration settings in Volts)
WARNING_THRESHOLD_V=0.020
CRITICAL_THRESHOLD_V=0.050

# Security and Authentication
# Change the default admin password hash upon first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_demo_password

# Optional Alert Notification Settings (SMTP Email)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
